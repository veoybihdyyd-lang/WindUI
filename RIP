local Players = game:GetService("Players")

-- ฟังก์ชันค้นหาผู้เล่นตามชื่อ
local function GetPlayerByName(name)
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name:lower():find(name:lower()) then
            return plr
        end
    end
    return nil
end

-- เลือกชื่อที่ต้องการล็อก
local nameToLock = "ชื่อผู้เล่นที่ต้องการล็อก"
local lockedPlayer = GetPlayerByName(nameToLock)

